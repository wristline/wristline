<?xml version="1.0" encoding="utf-8"?>
<!-- Full-color icon of the Samsung Now Bar card (MonitorService.nowBarExtras), shown untinted and
     with no backdrop: a white squircle (the case of branding/wristline-mark.svg), a navy dial
     (launcher navy, r=186 like the mark's dial) and a white prompt. The 512-unit case (40..472) is
     scaled 1.18 about the center so the squircle fills the icon edge to edge. The notification
     small icon and the OngoingActivity icon on other watches stay the monochrome ic_notification. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="1.18"
        android:scaleY="1.18">
        <path
            android:pathData="M180,40H332C424,40 472,88 472,180V332C472,424 424,472 332,472H180C88,472 40,424 40,332V180C40,88 88,40 180,40Z"
            android:fillColor="#FFFFFFFF" />
        <path
            android:pathData="M256,70A186,186 0,1 0,256 442A186,186 0,1 0,256 70Z"
            android:fillColor="#FF16324F" />
        <path
            android:pathData="M172,190L238,256L172,322M276,322H340"
            android:strokeWidth="46"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
